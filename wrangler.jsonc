/**
 * x402 Payment-Gated Proxy - Wrangler Configuration
 *
 * NOVA5 Wallet Intelligence
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova5-x402",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "public"
  },

  "vars": {
    "PAY_TO": "0x2d59f2b91bb59a5959fe1f958b96f538108c95c7",

    "NETWORK": "base",

    "PROTECTED_PATTERNS": [
      {
        "pattern": "/wallet*",
        "price": "$0.001",
        "description": "Base Wallet Intelligence"
      }
    ],

    "ORIGIN_URL": "https://nova5-hober.yesterdays-signal.workers.dev",

    "FACILITATOR_URL": "https://x402.org/facilitator"
  },

  "upload_source_maps": true
}
