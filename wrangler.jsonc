/**
 * x402 Payment-Gated Proxy - Wrangler Configuration
 *
 * NOVA5 Wallet Intelligence
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova5-x402",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "public"
  },

  "vars": {
    "PAY_TO": "0x2d59f2b91bb59a5959fe1f958b96f538108c95c7",

    "NETWORK": "base",

    "PROTECTED_PATTERNS": [
      {
        "pattern": "/wallet",
        "price": "$0.001",
        "description": "Base Wallet Intelligence"
      },
      {
        "pattern": "/wallet-decision",
        "price": "$0.01",
        "description": "NOVA5 Wallet Decision"
      }},
{
  "pattern": "/x402-preflight",
  "price": "$0.01",
  "description": "NOVA5 x402 Payment Preflight"
}
    ],

    "ORIGIN_URL": "https://nova5-hober.yesterdays-signal.workers.dev",

    "FACILITATOR_URL": "https://facilitator.meshgateway.co"
  },

  "upload_source_maps": true
}
